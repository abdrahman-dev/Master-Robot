import os
import numpy as np
import wave
import pygame
import time

SAMPLE_RATE = 16000
DURATION = 5
FILENAME = "/tmp/mic_test.wav"

import sys
sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from voice import audio_device as ad

ALSA_CARD = ad.get_alsa_card_number()
if ALSA_CARD is None:
    ALSA_CARD = 0
    print("⚠️ No USB microphone detected — using card 0")
AUDIO_DEVICE = f"plughw:{ALSA_CARD},0"
print(f"🎤 Using audio device: {AUDIO_DEVICE}")


def record_audio():
    print("\n🎤 Recording 5 seconds... speak now")

    cmd = f"arecord -D {AUDIO_DEVICE} -f S16_LE -r {SAMPLE_RATE} -c 1 -d {DURATION} {FILENAME}"
    result = os.system(cmd)

    if result != 0:
        print(f"❌ arecord failed — check device ({AUDIO_DEVICE})")
        return False

    return True


def analyze_audio():
    wf = wave.open(FILENAME, "rb")
    frames = wf.readframes(wf.getnframes())
    audio = np.frombuffer(frames, dtype=np.int16).astype(np.float32)

    audio = audio / 32768.0

    rms = np.sqrt(np.mean(audio ** 2))
    peak = np.max(np.abs(audio))

    print("\n=== RESULTS ===")
    print(f"RMS  : {rms:.5f}")
    print(f"PEAK : {peak:.5f}")

    if peak < 0.01:
        print("\n❌ NO INPUT DETECTED")
    elif peak < 0.05:
        print("\n⚠️ VERY LOW SIGNAL (increase mic gain)")
    elif peak < 0.2:
        print("\n✅ GOOD INPUT (VAD friendly)")
    else:
        print("\n⚡ TOO LOUD (clipping possible)")
 

def live_meter():
    print("\n🎧 Live meter (pygame) — press ESC to exit")

    pygame.init()
    screen = pygame.display.set_mode((600, 200))
    clock = pygame.time.Clock()

    while True:
        os.system(f"arecord -D {AUDIO_DEVICE} -f S16_LE -r {SAMPLE_RATE} -c 1 -d 0.1 {FILENAME} >/dev/null 2>&1")

        wf = wave.open(FILENAME, "rb")
        frames = wf.readframes(wf.getnframes())
        audio = np.frombuffer(frames, dtype=np.int16).astype(np.float32)
        audio = audio / 32768.0

        volume = np.sqrt(np.mean(audio ** 2))

        screen.fill((10, 10, 10))

        bar_width = int(volume * 500)
        pygame.draw.rect(screen, (0, 255, 100), (50, 80, bar_width, 40))

        font = pygame.font.SysFont("Arial", 24)
        text = font.render(f"Volume: {volume:.5f}", True, (255, 255, 255))
        screen.blit(text, (50, 30))

        pygame.display.flip()
        clock.tick(10)

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                return
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    return


def list_devices():
    print("\n=== ALSA DEVICES ===")
    os.system("arecord -l")


if __name__ == "__main__":
    print("\n=== PI MIC TEST (ALSA ONLY) ===")
    print("1 - List devices")
    print("2 - Record test (5s)")
    print("3 - Live meter (pygame)")

    choice = input("\nSelect: ")

    if choice == "1":
        list_devices()

    elif choice == "2":
        if record_audio():
            analyze_audio()

    elif choice == "3":
        live_meter()

    else:
        print("Invalid choice")