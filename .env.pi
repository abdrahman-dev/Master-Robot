# ============================================================
# Rope — Raspberry Pi production settings
# Copy to .env:   cp .env.pi .env
# ============================================================

# --- ASR ---
ROBOT_ASR_PROVIDER=whisper
ROBOT_ASR_WHISPER_MODEL=small       # small (~900MB) for Pi 5 / Pi 4 8GB
                                    # base  (~140MB) for Pi 4 4GB

# --- VAD (lower threshold for quiet USB mics) ---
ROBOT_VAD_THRESHOLD=0.30
ROBOT_VAD_MIN_SPEECH_SEC=0.35
ROBOT_VAD_SILENCE_TIMEOUT_SEC=1.50
ROBOT_VAD_PRE_ROLL_SEC=0.50
ROBOT_VAD_CHUNK_MS=32
ROBOT_VAD_SAMPLE_RATE=16000

# --- TTS ---
ROBOT_TTS_ENGINE=edge_tts
ROBOT_TTS_AR_VOICE=ar-SA-HamedNeural
ROBOT_TTS_EN_VOICE=en-US-GuyNeural

# --- LLM ---
ROBOT_LLM_PROVIDER=openrouter
ROBOT_OPENROUTER_MODEL=openrouter/free
# Set this: ROBOT_OPENROUTER_API_KEY=sk-or-v1-...

# --- Camera ---
ROBOT_CAM_WIDTH=640
ROBOT_CAM_HEIGHT=480
ROBOT_CAM_FPS=15
CAMERA_AUTO_DETECT=true
CAMERA_DEVICE=

# --- Vision ---
ROBOT_VISION_PROFILE=balanced

# --- General ---
ROBOT_LOG_LEVEL=INFO
ROBOT_MIC_ENABLED=true
ROBOT_VOICE_INPUT_SOURCE=mobile        # both, usb, or mobile
