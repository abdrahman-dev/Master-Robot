# ── LLM (OpenRouter) ─────────────────────────────────────────────
# Get your API key from https://openrouter.ai/
ROBOT_OPENROUTER_API_KEY=

# LLM model to use (see https://openrouter.ai/models)
ROBOT_OPENROUTER_MODEL=openrouter/free

# Timeout for checking OpenRouter availability (seconds)
ROBOT_OPENROUTER_AVAILABILITY_TIMEOUT_SEC=5

# ── General ──────────────────────────────────────────────────────
# Logging level: DEBUG, INFO, WARNING, ERROR
ROBOT_LOG_LEVEL=INFO

# Student name displayed in the UI
ROBOT_STUDENT_NAME=Student

# Default session language: ar (Arabic) or en (English)
ROBOT_DEFAULT_SESSION_LANGUAGE=ar

# ── Voice Activity Detection (Silero VAD) ────────────────────────
# Speech detection sensitivity (0.0 - 1.0). Higher = less sensitive.
ROBOT_VAD_THRESHOLD=0.45

# Silence duration before ending a speech segment (seconds)
ROBOT_VAD_SILENCE_TIMEOUT_SEC=1.20

# Minimum speech duration to trigger ASR (seconds)
ROBOT_VAD_MIN_SPEECH_SEC=0.40

# Pre-speech buffer to capture the start of an utterance (seconds)
ROBOT_VAD_PRE_ROLL_SEC=0.40

# VAD sample rate (must match ASR sample rate)
ROBOT_VAD_SAMPLE_RATE=16000

# VAD chunk duration in milliseconds
ROBOT_VAD_CHUNK_MS=32

# ── ASR (Speech Recognition) ─────────────────────────────────────
# Provider: google (requires internet)
ROBOT_ASR_PROVIDER=google
ROBOT_ASR_SAMPLE_RATE=16000
ROBOT_ASR_LANGUAGE_MODE=auto

# ── TTS (Text-to-Speech) ─────────────────────────────────────────
# Engine: edge_tts (requires internet)
ROBOT_TTS_ENGINE=edge_tts

# ── Camera ───────────────────────────────────────────────────────
# Resolution and FPS (lower on Pi for performance)
ROBOT_CAM_WIDTH=1280
ROBOT_CAM_HEIGHT=720
ROBOT_CAM_FPS=30
ROBOT_CAM_INDEX=0

# Face detection threshold (0.0 - 1.0)
ROBOT_FACE_THRESHOLD=0.35
ROBOT_FACE_FRAME_SKIP=2

# ── Vision ───────────────────────────────────────────────────────
# Profile: minimal, balanced, full
ROBOT_VISION_PROFILE=balanced
