# ═══════════════════════════════════════════════════════════
# ROPE — Environment Configuration Template
# انسخ الملف ده لـ .env واملأ القيم المطلوبة
# cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ═══════════════════════════════════
# LLM Settings
# ═══════════════════════════════════
ROBOT_OPENROUTER_API_KEY=
ROBOT_OPENROUTER_MODEL=openrouter/free   # الموديل المستخدم / LLM model to use
ROBOT_OPENROUTER_AVAILABILITY_TIMEOUT_SEC=5   # ثواني فحص الاتصال / Timeout for API availability check
ROBOT_LLM_REQUEST_TIMEOUT_SEC=90    # أقصى وقت لطلب LLM / Max LLM request timeout
ROBOT_LLM_SUMMARIZE_TIMEOUT_SEC=60  # أقصى وقت لتلخيص المحادثة / Max summarization timeout
ROBOT_LLM_WINDOW_SIZE=50            # حجم نافذة المحادثة / Conversation sliding window size
ROBOT_LLM_PROVIDER=openrouter       # مزود LLM / LLM provider (openrouter or gemini)
ROBOT_GEMINI_API_KEY=               # مفتاح Google AI Studio / Google AI Studio API key
ROBOT_GEMINI_MODEL=gemini-3.5-flash # موديل Gemini / Gemini model name

# ═══════════════════════════════════
# General Settings
# ═══════════════════════════════════
ROBOT_LOG_LEVEL=INFO                # مستوى التسجيل / DEBUG, INFO, WARNING, ERROR
ROBOT_STUDENT_NAME=Student          # اسم الطالب / Student name displayed in UI
ROBOT_DEFAULT_SESSION_LANGUAGE=ar   # لغة الجلسة الافتراضية / Default session language (ar or en)
ROBOT_FULLSCREEN=false               # عرض ملء الشاشة / Start in fullscreen mode (true/false)
ROBOT_DEV_TEXT_INPUT=false           # إدخال نصي للتطوير / Enable keyboard text input (dev only)
ROBOT_MIC_ENABLED=true               # تفعيل أو تعطيل المايك / Enable or disable microphone input
ROBOT_VOICE_INPUT_SOURCE=mobile        # مصدر الإدخال الصوتي / both, usb, or mobile (both=USB mic + mobile app, usb=USB only, mobile=mobile app only)
ROBOT_ACADEMIC_MODE=true            # وضع التعليم الأكاديمي / Master switch for all academic features (set true in production)
ROBOT_ACADEMIC_API_PORT=8001         # منفذ API الأكاديمي / Academic API server port

# ═══════════════════════════════════
# VAD Settings (Voice Activity Detection)
# ═══════════════════════════════════
ROBOT_VAD_THRESHOLD=0.53            # حساسية كشف الصوت / 0.3=sensitive, 0.7=strict
ROBOT_VAD_SILENCE_TIMEOUT_SEC=1.20  # ثواني الصمت قبل إنهاء الجملة / Silence before ending speech
ROBOT_VAD_MIN_SPEECH_SEC=0.40       # أقل مدة للكلام بالثواني / Minimum speech duration to trigger ASR
ROBOT_VAD_PRE_ROLL_SEC=0.40         # بفر قبل بداية الكلام / Pre-speech buffer
ROBOT_VAD_SAMPLE_RATE=16000         # معدل عينة VAD / VAD sample rate in Hz
ROBOT_VAD_CHUNK_MS=32               # مدة القطعة بالمللي ثانية / VAD chunk duration in ms
ROBOT_VAD_TORCH_THREADS=1           # عدد خيوط PyTorch لـ VAD / Torch thread count for VAD
ROBOT_VAD_HUB_REPO=snakers4/silero-vad   # مستودع Silero VAD / Silero VAD hub repo
ROBOT_VAD_HUB_NAME=silero_vad       # اسم موديل Silero / Silero model name
ROBOT_VAD_TRUST_REPO=true           # الثقة في المستودع / Trust hub repo
ROBOT_VAD_MODEL_LOCAL_PATH=         # مسار محلي لموديل VAD / Local path for VAD model (optional)
ROBOT_VAD_MAX_ABS_AMP=1.0           # أقصى سعة للصوت / Maximum absolute amplitude

# ═══════════════════════════════════
# ASR Settings (Speech Recognition)
# ═══════════════════════════════════
ROBOT_ASR_PROVIDER=google           # مزود التعرف على الكلام / ASR provider (google or whisper)
ROBOT_ASR_SAMPLE_RATE=16000         # معدل عينة ASR / ASR sample rate in Hz
ROBOT_ASR_LANGUAGE_MODE=auto        # وضع اللغة / auto, ar, or en
ROBOT_ASR_DEFAULT_DURATION_SEC=5.0  # مدة التسجيل الافتراضية / Default recording duration
ROBOT_ASR_WHISPER_MODEL=small       # حجم موديل Whisper / tiny, small, or medium (small recommended for Pi)

# ═══════════════════════════════════
# Audio Device
# ═══════════════════════════════════
ROBOT_AUDIO_DEVICE=                 # أجهزة USB الصوتية: يُترك فارغًا للكشف التلقائي / Linux: "plughw:2,0" for ALSA card. Windows: device index (e.g. 1) or name substring (e.g. "Microphone")

# ═══════════════════════════════════
# Camera Settings — Pi-optimized (640x480@15fps)
# ═══════════════════════════════════
ROBOT_CAM_WIDTH=640                 # عرض الكاميرا / Camera width in pixels (Pi: 640, desktop: 1280)
ROBOT_CAM_HEIGHT=480                # ارتفاع الكاميرا / Camera height in pixels (Pi: 480, desktop: 720)
ROBOT_CAM_FPS=15                    # عدد الإطارات في الثانية / Camera FPS (Pi: 15, desktop: 30)
ROBOT_CAM_INDEX=0                   # رقم الكاميرا / Camera index (0=first camera)
ROBOT_CAM_FORMAT=BGR                # صيغة الإطار / Frame format
ROBOT_CAM_BUFFER=1                  # حجم بافر الكاميرا / Camera buffer size
CAMERA_AUTO_DETECT=true             # كشف تلقائي للكاميرا / Auto-detect working camera (true/false)
CAMERA_DEVICE=                      # جهاز كاميرا محدد / Specific camera device (e.g. /dev/video0 or 0)
ROBOT_FACE_THRESHOLD=0.35           # حد كشف الوجه / Face detection confidence threshold
ROBOT_FACE_FRAME_SKIP=2             # تخطي الإطارات للوجه / Face detection frame skip
ROBOT_FACE_SCALE_FACTOR=0.5         # عامل تصغير الصورة للوجه / Face processing scale factor

# ═══════════════════════════════════
# Platform Notes (auto-detected, no need to change)
# ═══════════════════════════════════
# Camera backend (picamera2 on Pi, opencv elsewhere) is auto-detected by vision/camera.py
# Audio sample rate mismatch (Pi mic native vs 16000Hz target) is auto-resampled by voice/pipeline.py
# No manual platform-specific changes needed below this line

# ═══════════════════════════════════
# Vision Settings
# ═══════════════════════════════════
ROBOT_VISION_PROFILE=balanced       # بروفايل الرؤية / minimal, balanced, or full
ROBOT_METRICS_OVERLAY=0             # عرض FPS على الشاشة / 1 to show overlay, 0 to hide
ROBOT_ADAPTIVE_SHEDDING=1           # تقليل الحمل التلقائي / 1 to enable, 0 to disable
ROBOT_TARGET_FRAME_MS=100           # الهدف بالمللي ثانية لكل إطار / Target ms per frame
ROBOT_MAX_FRAME_SKIP=10             # أقصى تخطي للإطارات / Maximum frame skip count

# ═══════════════════════════════════
# TTS Settings
# ═══════════════════════════════════
ROBOT_TTS_ENGINE=edge_tts           # محرك تحويل النص لكلام / TTS engine (edge_tts)
ROBOT_TTS_POLL_SEC=0.05             # فترة فحص التشغيل / Playback poll interval in seconds
ROBOT_TTS_AR_VOICE=ar-SA-HamedNeural   # صوت العربية / Arabic TTS voice
ROBOT_TTS_EN_VOICE=en-US-GuyNeural     # صوت الإنجليزية / English TTS voice

# ═══════════════════════════════════
# ESP32 TCP connection
# ═══════════════════════════════════
ROBOT_ESP32_IP=192.168.149.254       # عنوان ESP32 / ESP32 IP address
ROBOT_ESP32_PORT=3333                # منفذ TCP / ESP32 TCP port

# ═══════════════════════════════════
# Gesture Settings
# ═══════════════════════════════════
ROBOT_GESTURE_BUFFER_SIZE=7         # حجم بافر الإيماءات / Gesture smoothing buffer
ROBOT_GESTURE_STABILITY_FRAMES=4    # إطارات الاستقرار / Frames for gesture stability
ROBOT_GESTURE_MAX_HANDS=1           # أقصى عدد أيدي / Maximum hands to detect
ROBOT_GESTURE_MIN_CONFIDENCE=0.75   # حد الثقة للإيماءات / Minimum gesture confidence

# ═══════════════════════════════════
# Battery Monitor Settings
# ═══════════════════════════════════
ROBOT_BATTERY_LOW_VOLTAGE=7.1            # جهد البطارية المنخفض / Low battery warning threshold (volts)
ROBOT_BATTERY_CRITICAL_VOLTAGE=6.5       # جهد البطارية الحرج / Critical shutdown threshold (volts)
ROBOT_BATTERY_WARN_COUNTDOWN_SEC=30      # ثواني العد التنازلي قبل الإغلاق / Countdown before shutdown at low voltage
ROBOT_BATTERY_CHECK_INTERVAL_SEC=0.5     # فترة فحص البطارية / Polling interval for battery reads

# ═══════════════════════════════════
# Shutdown (Remote Shutdown System)
# ═══════════════════════════════════
SHUTDOWN_API_URL=http://127.0.0.1:8000/                    # عنوان API الإغلاق عن بعد / Backend URL (Railway)
SHUTDOWN_TOKEN=1234                    # رمز الإغلاق المشترك / Shared secret token
